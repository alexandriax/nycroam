# Copy to .env.local for local dev, and set the same keys in the Vercel
# project settings for production. All are read at BUILD time (NEXT_PUBLIC_*).

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave unset to disable the
# analytics tag (local/preview builds won't send hits).
NEXT_PUBLIC_GA_ID=

# Absolute site origin for og:image / canonical URLs. On Vercel this falls back
# to the deployment URL automatically; set it to pin the production origin.
NEXT_PUBLIC_SITE_URL=https://www.nycroam.com
